{
  "name": "badgetrip",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Framework-agnostic gamification primitives - points, achievements, streaks, tiers, leaderboards, escalators.",
  "scripts": {
    "build": "tsc -b && pnpm --filter @walangstudio/badgetrip-angular build",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && pnpm --filter @walangstudio/badgetrip-angular typecheck",
    "test:coverage": "vitest run --coverage --coverage.include=packages/*/src/** --coverage.exclude=packages/angular/** --coverage.exclude=**/types.ts",
    "clean": "tsc -b --clean",
    "test": "vitest run && pnpm --filter @walangstudio/badgetrip-angular test",
    "test:watch": "vitest",
    "lint": "biome check .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && pnpm --filter @badgetrip-example/playground build && node -e \"require('node:fs').cpSync('examples/playground/dist', 'docs/.vitepress/dist/playground', { recursive: true })\"",
    "docs:preview": "vitepress preview docs",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "25.0.1",
    "typescript": "5.7.2",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.3.0",
  "license": "MIT"
}

{
  "name": "@badgetrip/react",
  "version": "0.0.2",
  "description": "React hooks and an AchievementBadge for badgetrip.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@badgetrip/assets": "workspace:*",
    "@badgetrip/core": "workspace:*",
    "@badgetrip/html": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "keywords": ["gamification", "react", "hooks"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walangstudio/badgetrip.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/walangstudio/badgetrip#readme",
  "bugs": "https://github.com/walangstudio/badgetrip/issues"
}

{
  "name": "@walangstudio/badgetrip-vue",
  "version": "0.1.0",
  "description": "Vue 3 plugin, composables and an AchievementBadge for badgetrip.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@walangstudio/badgetrip-assets": "workspace:*",
    "@walangstudio/badgetrip-core": "workspace:*",
    "@walangstudio/badgetrip-html": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^25.0.1",
    "vue": "^3.5.43"
  },
  "keywords": ["gamification", "vue", "composables"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walangstudio/badgetrip.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/walangstudio/badgetrip#readme",
  "bugs": "https://github.com/walangstudio/badgetrip/issues"
}

{
  "name": "@badgetrip/core",
  "version": "0.0.2",
  "description": "Framework-agnostic gamification engine. Zero runtime dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "keywords": ["gamification", "achievements", "streaks", "leaderboard", "event-sourcing"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walangstudio/badgetrip.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/walangstudio/badgetrip#readme",
  "bugs": "https://github.com/walangstudio/badgetrip/issues"
}

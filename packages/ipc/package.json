{
  "name": "@badgetrip/ipc",
  "version": "0.0.2",
  "description": "Run a badgetrip engine in one process (Electron main, a worker, a server) and use it from another over a message transport.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@badgetrip/core": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walangstudio/badgetrip.git",
    "directory": "packages/ipc"
  },
  "homepage": "https://github.com/walangstudio/badgetrip#readme",
  "bugs": "https://github.com/walangstudio/badgetrip/issues"
}

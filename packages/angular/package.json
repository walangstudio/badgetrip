{
  "name": "@walangstudio/badgetrip-angular",
  "version": "0.0.1",
  "description": "Angular signals, provider and badge component for badgetrip. Standalone, zoneless-ready.",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "typecheck": "ngc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "dependencies": {
    "@walangstudio/badgetrip-assets": "workspace:*",
    "@walangstudio/badgetrip-core": "workspace:*",
    "@walangstudio/badgetrip-html": "workspace:*",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@angular/common": ">=17.1.0",
    "@angular/core": ">=17.1.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.5",
    "@analogjs/vitest-angular": "^2.7.5",
    "@angular/build": "~22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "jsdom": "^30.1.1",
    "ng-packagr": "^22.2.1",
    "rxjs": "^7.8.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "keywords": ["gamification", "angular", "signals"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walangstudio/badgetrip.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/walangstudio/badgetrip#readme",
  "bugs": "https://github.com/walangstudio/badgetrip/issues"
}

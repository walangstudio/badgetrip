{
  "name": "@walangstudio/badgetrip-assets",
  "version": "0.1.0",
  "description": "Default SVG achievement icons for badgetrip plus a key-based override resolver. Framework-agnostic.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "keywords": ["gamification", "achievements", "icons", "svg"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walangstudio/badgetrip.git",
    "directory": "packages/assets"
  },
  "homepage": "https://github.com/walangstudio/badgetrip#readme",
  "bugs": "https://github.com/walangstudio/badgetrip/issues"
}

{
  "name": "@badgetrip/assets",
  "version": "0.0.1",
  "description": "Default SVG achievement icons for badgetrip plus a key-based override resolver. Framework-agnostic.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "keywords": ["gamification", "achievements", "icons", "svg"],
  "license": "MIT"
}
